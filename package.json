{
  "name": "youtube-clipper",
  "description": "Clip part of a YouTube video and save it as an MP4.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox",
    "zip": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "lint:addon": "web-ext lint --source-dir .output/firefox-mv3",
    "dev:chrome": "wxt -b chrome",
    "build:chrome": "wxt build -b chrome",
    "zip:chrome": "wxt zip -b chrome",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run lint:addon"
  },
  "dependencies": {
    "mediabunny": "^1.59.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  },
  "license": "MIT"
}
